# LOCAL : laisser NODE_ENV=development. Aucun e-mail réel n’est envoyé sans Resend.
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATA_DIR=runtime

# PUBLICATION : NODE_ENV=production et toutes les variables suivantes requises.
# Générer chaque secret avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
ADMIN_KEY=
RESEND_API_KEY=
MAIL_FROM=Video Games Battle <vote@votre-domaine.fr>
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CONTACT_EMAIL=
# 1 UNIQUEMENT derrière votre reverse proxy qui remplace X-Forwarded-For.
TRUST_PROXY=0

# Sponsors confirmés, par langue (fr, en, es, pt, ja, zh, de, it). Le champ logo est facultatif.
SPONSORS_JSON={}

# Une annonce directe par langue. Exemple :
# ADS_JSON={"fr":{"name":"Nom de l’annonceur","url":"https://example.com","logo":"/assets/media/annonceur.png"}}
ADS_JSON={}
